; VEXA — Godot Project Configuration
; Engine configuration file.
; Generated by hand; regenerate via the Godot editor UI when convenient.
; VEXA = voxel/blocky tactical FPS, desert military setting (Dust Town).
;
; Tower of truth for art: see ART_DIRECTION.md
; 1 block = 0.1 m. 1 Godot unit = 1 metre.
;
; Godot 4.7.2.stable
; PC Windows native target. NOT a web/HTML5 build.

config_version=5

[application]

config/name="VEXA"
config/description="VEXA — voxel/blocky tactical FPS set in a dusty desert military theatre (Dust Town)."
config/version="0.1.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"
config/quit_on_go_back=false

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[rendering]

renderer/rendering_method="forward_plus"
textures/canvas_textures/default_texture_filter=0
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.76078433, 0.69803923, 0.5019608, 1)

[autoload]

; VEXA autoload order is deliberate (INSTRUCTION 4 — modular architecture).
;
; 1. GameEvents — the global signal bus. Loads FIRST because every other system
;    produces or consumes events. It is stateless and dependency-free.
; 2. Game       — the service registry. Loads SECOND because systems register into
;    it during their own _ready(), and anything resolving a service needs it live.
;
; Domain subsystems are NOT autoloaded. Each is instantiated by the scene that owns
; it and registers itself, which keeps them testable in isolation and keeps the
; global namespace small (rule 51).
GameEvents="*res://scripts/core/game_events.gd"
Game="*res://scripts/core/game.gd"
